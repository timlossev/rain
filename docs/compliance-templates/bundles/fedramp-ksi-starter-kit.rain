{
  "bundle_type": "rain_tenant_config",
  "bundle_version": 1,
  "exported_at": "2026-11-07T00:00:00+00:00",
  "source_tenant_slug": "template",
  "source_tenant_name": "FedRAMP 20x Key Security Indicators starter template",
  "secrets_included": false,
  "asset_types": [
    {
      "key": "security_control",
      "name": "Security Control",
      "icon": null,
      "description": "One row per control implementation statement -- a NIST 800-53 (or other catalog) control, how it's implemented, and by whom. Each Asset's own \"Name\" field identifies the control (and part, if tracked at that level), e.g. \"AC-2(a) Account Management\". Populate by hand, or bulk-import one of the FedRAMP rev5 baseline question lists (nist-800-53-rev5-low/moderate/high.csv, same directory), the ISO/IEC 27001:2022 Annex A control list (iso-27001-2022-annex-a-controls.csv), the SOC 2 Type II control list (soc2-type2-controls.csv), or one of the CMMC level lists (cmmc-level-1/2/3-controls.csv) to start from a real, currently-applicable control set instead of a blank register. Pairs with the oscal-control-implementation.jq transformer (see docs/compliance-templates/README.md) to export this register as an OSCAL control-implementation fragment, and with assessment-register.rain (same directory) for tracking assessments against these same rows.",
      "is_active": true,
      "sort_order": 0
    },
    {
      "key": "fedramp_ksi",
      "name": "Key Security Indicator",
      "icon": null,
      "description": "One row per FedRAMP 20x Key Security Indicator (KSI) -- 46 indicators across 10 families (Cybersecurity Education, Change Management, Cloud Native Architecture, Identity and Access Management, Incident Response, Monitoring/Logging/Auditing, Policy and Inventory, Recovery Planning, Supply Chain Risk, Service Configuration). Bulk-import fedramp-20x-key-security-indicators.csv (same directory) to start from the real, current indicator set, then fill in Implementation Status/Narrative/Validation/Assessment/Tests/Evidence by hand. Pairs with fedramp-ksi-export.jq and the FedRAMP Security Decision Record Export Recipe (see docs/compliance-templates/README.md) to fill in a real Security Decision Record's own keySecurityIndicators section, and with assessment-register.rain for tracking assessments against these same rows.",
      "is_active": true,
      "sort_order": 1
    }
  ],
