  "source_tenant_slug": "template",
  "source_tenant_name": "OSCAL System Security Plan starter kit (asset types + export recipe, one import)",
  "secrets_included": false,
  "asset_types": [
    {
      "key": "fedramp_certification_package",
      "name": "FedRAMP Certification Package",
      "icon": null,
      "description": "One row per FedRAMP-certified cloud service offering this tenant operates -- most tenants only ever need one. Mirrors fedramp.gov's own Certification Package Overview schema (fedramp-certification-package-overview-schema-2026-06-24.json): the CSP/service-identity metadata FedRAMP's marketplace listing expects, not a control-implementation SSP. Each Asset's own \"Name\" field is the service's own name (serviceName in that schema) -- pairs with fedramp-package-contacts.rain and fedramp-package-repositories.rain for the two repeating sections that schema carries as arrays. The FIPS 199/authorization boundary fields (added for OSCAL) aren't part of that marketplace schema -- they exist to feed transforms/oscal-system-characteristics.jq, the first step of the OSCAL System Security Plan Export Recipe (see docs/oscal-ssp-showcase.md).",
      "is_active": true,
      "sort_order": 0
    },
    {
      "key": "software_component",
      "name": "Software Component",
      "icon": null,
      "description": "One row per in-scope Control Plane software component, container image, package, or dependency -- a Software Bill of Materials (SBOM) register. Each Asset's own \"Name\" field is the component or package name. Distinct from the Software License Register (`software-license-register.rain`), which tracks vendor agreements and renewals, not what's actually running.",
      "is_active": true,
      "sort_order": 0
    },
    {
      "key": "security_control",
      "name": "Security Control",
      "icon": null,
      "description": "One row per control implementation statement -- a NIST 800-53 (or other catalog) control, how it's implemented, and by whom. Each Asset's own \"Name\" field identifies the control (and part, if tracked at that level), e.g. \"AC-2(a) Account Management\". Populate by hand, or bulk-import one of the FedRAMP rev5 baseline question lists (nist-800-53-rev5-low/moderate/high.csv, same directory), the ISO/IEC 27001:2022 Annex A control list (iso-27001-2022-annex-a-controls.csv), the SOC 2 Type II control list (soc2-type2-controls.csv), or one of the CMMC level lists (cmmc-level-1/2/3-controls.csv) to start from a real, currently-applicable control set instead of a blank register. Pairs with the oscal-control-implementation.jq transformer (see docs/compliance-templates/README.md) to export this register as an OSCAL control-implementation fragment, and with assessment-register.rain (same directory) for tracking assessments against these same rows.",
      "is_active": true,
      "sort_order": 0
    }
  ],
