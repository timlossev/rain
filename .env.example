# Copy to .env and fill in, or just run bootstrap.py / bootstrap.ps1 / bootstrap.sh
# to auto-generate a .env with strong random secrets, plus a few interactive
# deployment questions covering the settings below (external Postgres, S3
# storage, embedding the worker) -- defaults to everything as it already
# appears here if you accept the offered default setup, or if bootstrap runs
# non-interactively (e.g. in CI). Nothing else is required to boot RAIN --
# everything past this point is configured at runtime from the in-app setup
# wizard and Admin UI, stored in Postgres.

# Postgres credentials used by the db + app + worker containers. Ignored
# if POSTGRES_URL is set below (an external/managed Postgres supplies its
# own credentials as part of that URL).
POSTGRES_USER=rain
POSTGRES_PASSWORD=
POSTGRES_DB=rain

# Used to sign session cookies and to derive the Fernet key that encrypts
# sensitive config at rest (e.g. the SMTP relay password). Generate with
# bootstrap.py -- do not reuse across environments, and do not commit it.
APP_SECRET_KEY=

# Public domain Caddy should request a real ACME certificate for.
# Leave as "localhost" (or unset) for local/dev use -- Caddy will then issue
# certificates from its internal CA automatically, no config required.
RAIN_DOMAIN=localhost

# TCP+UDP port the worker's syslog listener binds to (both host and
# container side). Point your syslog-ng destination at this host:port --
# see docs/architecture.md for the syslog-ng destination snippet.
SYSLOG_PORT=5514

# Set this to use an external/managed Postgres (e.g. RDS) instead of the
# one RAIN would otherwise run itself, e.g.
#   POSTGRES_URL=postgresql://user:password@my-db-host:5432/rain
# When set, also drop "local-db" from COMPOSE_PROFILES below so RAIN
# doesn't build and start its own Postgres container alongside it.
POSTGRES_URL=

# Port the app container's own HTTP server listens on, and (when
# WEB_FRONTEND is on) the port Caddy proxies to internally. Only worth
# changing if 8000 conflicts with something else already on the host --
# this is not the public port; Caddy still serves on 80/443 either way.
APP_PORT=8000

# Set to false (or 0) to skip Caddy entirely -- for deployments that
# already terminate TLS in front of RAIN (e.g. behind an AWS ALB) and
# just need the app container reachable on APP_PORT directly. When
# false, also drop "web-frontend" from COMPOSE_PROFILES below.
WEB_FRONTEND=true

# Which of RAIN's own containers docker compose actually starts, comma-
# separated. "local-db" is RAIN's own Postgres (drop it if POSTGRES_URL
# is set above); "web-frontend" is Caddy (drop it if WEB_FRONTEND=false
# above); "worker" is the syslog listener + rule engine container (drop
# it if EMBED_WORKER=true below). This is what those three settings
# actually take effect through -- Compose profiles can't be toggled from
# inside a plain KEY=VALUE variable, so keep this in sync with them by
# hand.
COMPOSE_PROFILES=local-db,web-frontend,worker

# Local development only -- puts full tracebacks (source paths, local
# variables, SQL text) in 500 responses. Never set true on a real
# deployment.
DEBUG=false

# Document repository storage (rain.modules.documents.storage). Leave
# S3_BUCKET empty to store documents on the rain_uploads volume, same as
# every other release so far. Set it to store them in that S3 (or
# S3-compatible -- MinIO, etc.) bucket instead, e.g.:
#   S3_BUCKET=my-rain-documents
#   S3_REGION=us-east-1
# S3_ENDPOINT_URL is what points this at a self-hosted S3-compatible
# service instead of real AWS S3 -- leave it empty for AWS. Leave
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY both empty on real AWS to use an
# instance/task IAM role instead of a static key pair; a self-hosted
# service typically needs the pair set explicitly.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set to true to fold the worker container's own duties (syslog
# listener, rule engine, notifications, calendar sweep, LDAP sync) into
# the app container instead of running them as a separate `worker`
# service. Combined with POSTGRES_URL (an external/managed Postgres),
# WEB_FRONTEND=false (skip Caddy), and S3_BUCKET (skip the local uploads
# volume), this is what gets you down to a single container with no
# other RAIN-managed infrastructure -- "minimal mode":
#
#   EMBED_WORKER=true
#   POSTGRES_URL=postgresql://user:password@my-db-host:5432/rain
#   WEB_FRONTEND=false
#   S3_BUCKET=my-rain-documents
#   COMPOSE_PROFILES=
#
# ...then bring it up with the minimal-mode overlay, which adds the
# syslog port mapping the app container doesn't declare by default (see
# docker-compose.minimal.yml for why):
#
#   docker compose -f docker-compose.yml -f docker-compose.minimal.yml up --build
#
# Or skip Compose too and run this same .env straight through `docker
# run --env-file` (the app reads POSTGRES_URL directly, the same as
# Compose's own ${POSTGRES_URL:-...} substitution would have) -- see
# README.md's Quickstart for the exact command; `bootstrap` prints it
# for you automatically once EMBED_WORKER/WEB_FRONTEND above are set
# this way. Either way, stop any other RAIN instance already using
# APP_PORT/SYSLOG_PORT first -- Docker fails to start a second
# container on either with "port is already allocated" otherwise, which
# is a normal Docker port conflict, not specific to this deployment
# shape.
#
# Leave false (the default) for the normal two-container app+worker
# split -- that's still the recommended shape for anything beyond a
# quick eval or a genuinely constrained environment.
EMBED_WORKER=false

# Reserves the Postgres `vector` extension/type for a future semantic-
# search source (unused today -- search is full-text only, see
# rain.modules.search). On by default; set to false if your Postgres
# can't create it -- either because the role RAIN connects as isn't
# allowed to (a typical minimum-privilege managed-database setup;
# asyncpg.exceptions.InsufficientPrivilegeError is the error you'd see)
# or because the extension isn't offered at all (e.g. standard RDS in
# AWS GovCloud). Safe to turn off: nothing reads or writes the reserved
# columns this skips. Changing it after RAIN has already run its
# migrations once only affects schemas/migrations from that point on,
# same as every other setting here.
ENABLE_PGVECTOR=true
