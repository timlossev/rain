# Copy to .env and fill in, or just run bootstrap.py / bootstrap.ps1 / bootstrap.sh
# to auto-generate a .env with strong random secrets. Nothing else is required
# to boot RAIN -- everything past this point is configured at runtime from the
# in-app setup wizard and Admin UI, stored in Postgres.

# Postgres credentials used by the db + app + worker containers. Ignored
# if POSTGRES_URL is set below (an external/managed Postgres supplies its
# own credentials as part of that URL).
POSTGRES_USER=rain
POSTGRES_PASSWORD=
POSTGRES_DB=rain

# Used to sign session cookies and to derive the Fernet key that encrypts
# sensitive config at rest (e.g. the SMTP relay password). Generate with
# bootstrap.py -- do not reuse across environments, and do not commit it.
APP_SECRET_KEY=

# Public domain Caddy should request a real ACME certificate for.
# Leave as "localhost" (or unset) for local/dev use -- Caddy will then issue
# certificates from its internal CA automatically, no config required.
RAIN_DOMAIN=localhost

# TCP+UDP port the worker's syslog listener binds to (both host and
# container side). Point your syslog-ng destination at this host:port --
# see docs/architecture.md for the syslog-ng destination snippet.
SYSLOG_PORT=5514

# Set this to use an external/managed Postgres (e.g. RDS) instead of the
# one RAIN would otherwise run itself, e.g.
#   POSTGRES_URL=postgresql://user:password@my-db-host:5432/rain
# When set, also drop "local-db" from COMPOSE_PROFILES below so RAIN
# doesn't build and start its own Postgres container alongside it.
POSTGRES_URL=

# Port the app container's own HTTP server listens on, and (when
# WEB_FRONTEND is on) the port Caddy proxies to internally. Only worth
# changing if 8000 conflicts with something else already on the host --
# this is not the public port; Caddy still serves on 80/443 either way.
APP_PORT=8000

# Set to false (or 0) to skip Caddy entirely -- for deployments that
# already terminate TLS in front of RAIN (e.g. behind an AWS ALB) and
# just need the app container reachable on APP_PORT directly. When
# false, also drop "web-frontend" from COMPOSE_PROFILES below.
WEB_FRONTEND=true

# Which of RAIN's own containers docker compose actually starts, comma-
# separated. "local-db" is RAIN's own Postgres (drop it if POSTGRES_URL
# is set above); "web-frontend" is Caddy (drop it if WEB_FRONTEND=false
# above). This is what those two settings actually take effect through --
# Compose profiles can't be toggled from inside a plain KEY=VALUE
# variable, so keep this in sync with them by hand.
COMPOSE_PROFILES=local-db,web-frontend

# Local development only -- puts full tracebacks (source paths, local
# variables, SQL text) in 500 responses. Never set true on a real
# deployment.
DEBUG=false
